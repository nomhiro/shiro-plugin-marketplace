{
  "$schema": "https://code.claude.com/schemas/marketplace.json",
  "name": "shiro-plugin-marketplace",
  "owner": {
    "name": "nomhiro",
    "url": "https://github.com/nomhiro"
  },
  "metadata": {
    "description": "nomhiro's Claude Code plugins",
    "version": "0.8.0"
  },
  "plugins": [
    {
      "name": "udemy-exam-prep",
      "source": "./plugins/udemy-exam-prep",
      "description": "認定資格の試験対策問題集（Udemy 演習テスト講座）を、公式ドキュメント調査からフル模試生成・Udemy へのアップロードまで一貫して作成するハーネス",
      "version": "0.7.0",
      "author": {
        "name": "nomhiro"
      },
      "homepage": "https://github.com/nomhiro/shiro-plugin-marketplace",
      "repository": "https://github.com/nomhiro/shiro-plugin-marketplace",
      "license": "MIT",
      "keywords": [
        "udemy",
        "certification",
        "practice-test",
        "quiz",
        "exam-prep"
      ]
    },
    {
      "name": "udemy-video-course",
      "source": "./plugins/udemy-video-course",
      "description": "動画講座（Udemy）のレクチャーを、スライドとナレーション台本からAI音声付きの動画にするハーネス。座学と実践（ハンズオン）の両方に対応し、実践は Claude 自身が画面を操作して素材を撮る収録モードを持つ。品質ゲート（TTS異常・沈黙率・文体・映り込み）と第三者レビューをパイプラインに組み込む",
      "version": "0.2.0",
      "author": {
        "name": "nomhiro"
      },
      "homepage": "https://github.com/nomhiro/shiro-plugin-marketplace",
      "repository": "https://github.com/nomhiro/shiro-plugin-marketplace",
      "license": "MIT",
      "keywords": [
        "udemy",
        "video-course",
        "tts",
        "screencast",
        "narration",
        "ffmpeg"
      ]
    },
    {
      "name": "stop-ai-slop-jp",
      "source": "./plugins/stop-ai-slop-jp",
      "description": "AIで書いた日本語から、AI臭さを取り除くスキル。主体の不在、命題型の見出し、全角ダッシュ、偏愛語、リズムの均一さを直す。iKora128/stop-ai-slop-jp（MIT）をそのまま取り込んだもの",
      "version": "0.1.1",
      "author": {
        "name": "Daichi Nagashima",
        "url": "https://genshi.ai/"
      },
      "homepage": "https://github.com/iKora128/stop-ai-slop-jp",
      "repository": "https://github.com/iKora128/stop-ai-slop-jp",
      "license": "MIT",
      "keywords": [
        "japanese",
        "writing",
        "editing",
        "ai-slop",
        "proofreading"
      ]
    }
  ]
}
